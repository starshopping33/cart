<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header>
        <div class="header-container">
            <img src="download.jpg" alt="Logo Buscapé" class="logo">
            <nav>
                <div class="cart-icon">
                    <span class="cart-count"></span>
                </div>
            </nav>
        </div>
    </header>
    
    <div class="container">
        <section class="produtos">
            <h2>Produtos Disponíveis</h2>
            <ul class="lista-produtos"></ul>
        </section>
        
        <section class="carrinho">
            <h2>Seu Carrinho</h2>
            <ul class="carrinho"></ul>
            <div class="subtotal">
                <p>Subtotal</p>
                <div class="preco-total">
                    <span class="parcelas">00</span>
                    <span class="vista"></span>
                </div>
            </div>
        </section>
    </div>
    


    <script type="module" src="java.js"></script>
</body>
</html>
